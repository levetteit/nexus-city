# Nexus City: configuration template.
#
# Local: copy to `.env` (git-ignored) and run  uvicorn backend.main:app --env-file .env
# Hosted: set these in your host's environment settings (Render → Environment).
# PLACEHOLDERS ONLY: never put real credentials in this file or anywhere else in the repository.
#
# Everything is optional unless marked REQUIRED. Leave a line commented out to use its default (shown after "default:").
# Each NEXUS_<NAME> also accepts the project's former name STARNET_<NAME> (docs/MIGRATION_FROM_STARNET.md).
# Third-party names (ANTHROPIC_*, STRIPE_*, ETSY_*, PINTEREST_*, PRINTIFY_*) are used as-is.
# Lines marked SECRET hold credentials: keep them out of chats, screenshots, logs and commits.

# ============================================================== APPLICATION
# sim = simulated market (local development); live = real candles, paper trading, optional real orders.
NEXUS_MODE=sim
# Where state is kept (accounts, trades, the station's records, the audit log). default: data
# NEXUS_DATA_DIR=data
# The app's public https address. Needed for the storefront, post images, push links and OAuth redirects.
# On Render it falls back to RENDER_EXTERNAL_URL, which Render sets itself.
# NEXUS_PUBLIC_URL=https://your-app.example.com
# Simulation speed: real seconds between market ticks. default: 1.0
# NEXUS_TICK_SECONDS=1.0

# ============================================================== AUTHENTICATION
# REQUIRED for any deployment reachable from the internet: without it every page and control (including real
# order arming) is open. Password for every page, API call and the WebSocket (HTTP Basic, then a session cookie).
# SECRET
NEXUS_PASSWORD=change-me-to-a-long-random-password
# Bearer token for the Jarvis operations API (/api/jarvis/brief, /api/jarvis/act); at least 24 characters.
# Without it those endpoints don't exist. SECRET
# NEXUS_JARVIS_TOKEN=replace-with-a-random-string-of-at-least-24-characters

# ============================================================== AI
# Anthropic API key: the trading desk (journals, news, daily plan) and the AI operations station. SECRET
# ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
# Optional Admin API key, read-only use: reconciles the station's credit balance with Anthropic's cost report. SECRET
# ANTHROPIC_ADMIN_KEY=sk-ant-admin-REPLACE_ME
# Models. default: claude-opus-5-5
# NEXUS_DESK_MODEL=claude-opus-5-5
# NEXUS_STATION_MODEL=claude-opus-5-5
# Station AI spend cap per month, in USD. default: 50
# NEXUS_STATION_AI_BUDGET=50
# Warn when prepaid credits fall below this many USD. default: 5
# NEXUS_CREDITS_LOW=5
# Agent drafting runs per day, and how many experimental ventures may run at once. defaults: 25, 3
# NEXUS_STATION_TASKS_PER_DAY=25
# NEXUS_STATION_EXPERIMENTS=3
# $0 ventures the crew can run alone launch without an approval (1/0), and close after N days with no sale.
# defaults: 1, 21
# NEXUS_AUTO_LAUNCH=1
# NEXUS_AUTO_KILL_DAYS=21

# ============================================================== TRADING
# Shared secret in the TradingView "Nexus City feed" script (tradingview/nexus_city_feed.pine): real-time candles. SECRET
# NEXUS_FEED_SECRET=replace-with-a-random-string
# Shared secret for TradingView signal alerts posted to /api/tradingview. SECRET
# NEXUS_WEBHOOK_SECRET=replace-with-a-random-string
# TradersPost strategy webhook URL(s), comma-separated. Real orders go here once you ARM them in the app. SECRET
# NEXUS_TRADERSPOST_WEBHOOKS=https://webhooks.traderspost.io/trading/webhook/REPLACE/ME
# Funded-stage guard overrides, in USD (defaults follow the evaluation rules in backend/account.py).
# NEXUS_FUNDED_DAILY_GOAL=600
# NEXUS_FUNDED_DAILY_CAP=1200
# NEXUS_FUNDED_DAILY_STOP=600
# NEXUS_FUNDED_KEEP_ROOM=1500
# No new trades this many minutes before and after high-impact news (and after FOMC); flatten this many
# minutes before. defaults: 10, 15, 45, 2
# NEXUS_NEWS_BEFORE=10
# NEXUS_NEWS_AFTER=15
# NEXUS_NEWS_AFTER_FOMC=45
# NEXUS_NEWS_FLATTEN=2
# Your share of a prop-firm payout, for the treasury. default: 0.9
# NEXUS_PAYOUT_SPLIT=0.9

# ============================================================== PAYMENTS
# Stripe secret key: payment links for the storefront. Use a restricted or test key while developing. SECRET
# STRIPE_API_KEY=sk_test_REPLACE_ME
# Stripe webhook signing secret for /api/station/stripe/webhook. SECRET
# STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
# Share of income set aside as an estimated tax reserve in the finance report (an estimate, not advice). default: 0.25
# NEXUS_TAX_RATE=0.25

# ============================================================== EMAIL
# SMTP for outreach and the test email. IMAP (same login) reads replies, and opt-outs go on the do-not-contact list.
# NEXUS_SMTP_HOST=smtp.example.com
# NEXUS_SMTP_PORT=587
# NEXUS_SMTP_USER=you@example.com
# An app password, not your mailbox password. SECRET
# NEXUS_SMTP_PASSWORD=REPLACE_ME
# NEXUS_MAIL_FROM=Your Name <you@example.com>
# Postal address required in commercial email.
# NEXUS_MAIL_ADDRESS=PO Box 0, City, ST 00000
# Optional: worked out from the SMTP host for Gmail and Outlook.
# NEXUS_IMAP_HOST=imap.example.com

# ============================================================== SOCIAL
# Facebook Page and its linked Instagram professional account.
# NEXUS_FB_PAGE_ID=000000000000000
# A long-lived Page access token (pages_manage_posts, pages_read_engagement; for Instagram also
# instagram_basic and instagram_content_publish). SECRET
# NEXUS_FB_PAGE_TOKEN=REPLACE_ME
# NEXUS_IG_USER_ID=00000000000000000
# The one venture allowed to post on the Page. default: V-PPS
# NEXUS_FB_PAGE_VENTURE=V-PPS
# Pin a Graph API version (empty = the app's default).
# NEXUS_META_GRAPH_VERSION=
# LinkedIn (w_member_social; expires every 60 days). SECRET
# NEXUS_LINKEDIN_TOKEN=REPLACE_ME
# NEXUS_LINKEDIN_PERSON=urn:li:person:REPLACE_ME

# ============================================================== COMMERCE
# Printify (print-on-demand listings to the Etsy shop). SECRET
# PRINTIFY_API_TOKEN=REPLACE_ME
# PRINTIFY_SHOP_ID=00000000
# Storefront name and the contact email shown on its pages. default name: Nexus City Studio
# NEXUS_STORE_NAME=Nexus City Studio
# NEXUS_STORE_EMAIL=store@example.com

# ============================================================== OUTBOUND POLICY AND CAPS
# What happens to a draft that passes Compliance & QA: auto = sent by the station, owner = waits for your OK.
# defaults: auto
# NEXUS_POLICY_SOCIAL=auto
# NEXUS_POLICY_OUTREACH=auto
# NEXUS_POLICY_STRIPE=auto
# NEXUS_POLICY_SHOP=auto
# NEXUS_POLICY_DIGITAL=auto
# Daily caps. defaults: 6, 15, 2, 3
# NEXUS_POSTS_PER_DAY=6
# NEXUS_OUTREACH_PER_DAY=15
# NEXUS_SHOP_LISTINGS_PER_DAY=2
# NEXUS_DIGITAL_PER_DAY=3
# Product cadence: hours between new products, max products on sale per venture, hours between Etsy
# best-seller scans, minimum profit per Printify item in cents. defaults: 24, 6, 48, 400
# NEXUS_DIGITAL_EVERY_HOURS=24
# NEXUS_DIGITAL_MAX_PER_VENTURE=6
# NEXUS_SHOP_RESEARCH_HOURS=48
# NEXUS_SHOP_MIN_PROFIT_CENTS=400

# ============================================================== OAUTH
# Etsy app (keystring and shared secret from etsy.com/developers). Redirect URI to register:
# <public url>/api/station/connect/etsy/callback
# ETSY_KEYSTRING=REPLACE_ME
# ETSY_SHARED_SECRET=REPLACE_ME
# Pinterest app. Redirect URI to register: <public url>/api/station/connect/pinterest/callback
# PINTEREST_APP_ID=REPLACE_ME
# PINTEREST_APP_SECRET=REPLACE_ME
# Set to 1 to use Pinterest's sandbox API.
# PINTEREST_SANDBOX=

# ============================================================== NOTIFICATIONS
# ntfy topic for phone alerts (backup to web push). Anyone who knows the topic can read it: make it long and random.
# NEXUS_NTFY_TOPIC=nexus-REPLACE-WITH-RANDOM
# Web push key (PEM). Without it a key is generated once and kept in the data directory. SECRET
# NEXUS_VAPID_PRIVATE_KEY=
# Contact sent to push services. default: mailto:nexus-city-alerts@users.noreply.github.com
# NEXUS_PUSH_CONTACT=mailto:you@example.com
